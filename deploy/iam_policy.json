{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDatasetAndOutputPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["raw/*", "models/*", "results/*"]
        }
      }
    },
    {
      "Sid": "ReadDatasetAndModels",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/raw/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/models/*"
      ]
    },
    {
      "Sid": "PublishRetrainOutputs",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::YOUR_BUCKET_NAME/models/*",
        "arn:aws:s3:::YOUR_BUCKET_NAME/results/*"
      ]
    }
  ]
}
